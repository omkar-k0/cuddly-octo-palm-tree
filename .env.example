# All of these are server-side only. Never prefix them with NEXT_PUBLIC_.

# ── Answers ─────────────────────────────────────────────────────────────────
# Claude API key. Without it the app runs in mock mode (answers labelled "Mock").
ANTHROPIC_API_KEY=
# "live" or "mock". Defaults to live when ANTHROPIC_API_KEY is set, else mock.
LLM_MODE=

# ── Team, lawyer accounts and verification (/team, /admin) ─────────────────
# Postgres connection string. Required on Vercel (add Neon from Storage →
# Marketplace and this is set for you). Locally, leave it empty: an embedded
# database (PGlite) in .data/pglite is used instead.
DATABASE_URL=
# Used only once: to create the first owner account(s) when the users table
# is empty. "email:hash" pairs separated by commas.
# Make a hash with:  npm run -s admin:hash   (then type the password)
# All other accounts (admins, lawyers) are created in /team, not here.
ADMIN_USERS=
