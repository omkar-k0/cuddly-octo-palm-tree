# All of these are server-side only. Never prefix them with NEXT_PUBLIC_.

# ── Answers ─────────────────────────────────────────────────────────────────
# Claude API key. Without it the app runs in mock mode (answers labelled "Mock").
ANTHROPIC_API_KEY=
# "live" or "mock". Defaults to live when ANTHROPIC_API_KEY is set, else mock.
LLM_MODE=

# ── Lawyer verification dashboard (/admin) ─────────────────────────────────
# Postgres connection string for verification decisions. On Vercel, add Neon
# from Storage → Marketplace and this is set for you. Locally, leave empty to
# save decisions to .data/verifications.json.
DATABASE_URL=
# Lawyer accounts: "email:hash" pairs separated by commas.
# Make a hash with:  npm run -s admin:hash   (then type the password)
ADMIN_USERS=
# Random secret (32+ characters) that signs login sessions.
# Make one with:     npm run -s admin:secret
ADMIN_SESSION_SECRET=
